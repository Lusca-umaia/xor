# Copie para .env.local e preencha. O .env.local nunca é commitado.

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<chave publicável>
SUPABASE_SECRET_KEY=<chave secreta>

# Links absolutos do Open Graph (opcional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IA local do Ambiente de Estudo (API compatível com a OpenAI).
# Prepare com: npm run ia:setup
# Ollama em outra máquina da rede: http://<ip-da-maquina>:11434/v1
LM_STUDIO_URL=http://localhost:11434/v1
LM_STUDIO_MODEL=xor-estudo
EMBEDDING_MODEL=nomic-embed-text-v2-moe

# Chat com IA (Together AI, opcional)
TOGETHER_API_KEY=
